//@version=6
// ============================================================================
// BIST HODL-Beater — Rejim Filtresi Stratejisi (Günlük + Haftalık)
// ----------------------------------------------------------------------------
// ANA MOD — Rejim Filtresi (3 aşamalı sağlamlık testinden geçti):
//   Varsayılan pozisyon LONG. Yalnızca ÇİFTE ayı teyidinde çıkar:
//     kapanış < SMA(131 gün) × (1 − %3)  VE  284 günlük momentum < 0
//   Geri giriş hızlıdır: kapanış > SMA  VEYA  momentum > 0.
//   Literatür: Faber (2007) trend filtresi + Antonacci (2014) mutlak momentum
//   + Zakamulin histerezis bandı. Amaç: boğayı kaçırmadan büyük ayıları atlamak.
//
// ZİRVE İZ STOP MODU (3 aşamalı testten geçti, tepeye yakın satış):
//   SAT: kapanış, pozisyon zirvesinin %10 altına inince — satış her zaman son
//   zirveye yakın gerçekleşir, dipte değil. AL: kapanış > SMA veya momentum > 0
//   veya kapanış çıkış fiyatını aşarsa (breakeven — yanlış alarmın maliyeti
//   2 komisyonla sınırlanır). Rejim moduna göre daha sık işlem yapar.
//
// DENEYSEL MOD — Komposit Puanlama (6 indikatör oylaması):
//   Supertrend (Seban) + EMA kesişimi (Brock-Lakonishok-LeBaron 1992) +
//   MACD (Appel) + RSI (Wilder 1978) + Donchian (Donchian/Turtle) + DMI (Wilder),
//   Chandelier Exit (LeBeau) iz süren stop seçeneğiyle. Sağlamlık testinde
//   güçlü boğada HODL'un gerisinde kaldı — yalnızca araştırma amaçlı.
//
// Periyot girdileri İŞLEM GÜNÜ cinsindendir ve haftalık grafikte otomatik
// ölçeklenir (131 gün ≈ 27 hafta). Sağ üstteki tablo, seçili parametrelerle
// geçmiş performansı HODL (al-ve-tut) ile karşılaştırır; parametre
// değiştirdikçe canlı güncellenir. Long/flat çalışır, açığa satış yoktur.
// ============================================================================
strategy("BIST HODL-Beater [Rejim Filtresi]",
     shorttitle = "BIST HODL-Beater",
     overlay = true,
     initial_capital = 100000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type = strategy.commission.percent,
     commission_value = 0.1,
     slippage = 0,
     calc_on_every_tick = false,
     process_orders_on_close = false,
     max_labels_count = 500)

// ─── Girdiler ───────────────────────────────────────────────────────────────
grpMod = "0) Strateji Modu"
mod = input.string("Rejim Filtresi (doğrulanmış)", "Mod",
     options = ["Rejim Filtresi (doğrulanmış)", "Zirve İz Stop (tepeye yakın satış)", "Komposit Puanlama (deneysel)"], group = grpMod)

grpRejim = "1) Rejim Filtresi — periyotlar işlem günü cinsinden"
smaGun  = input.int(131, "Trend SMA (gün)", minval = 20, group = grpRejim,
     tooltip = "Doğrulanmış plato: 131-150 gün. Haftalık grafikte otomatik ölçeklenir.")
momGun  = input.int(284, "Momentum penceresi (gün)", minval = 40, group = grpRejim,
     tooltip = "Doğrulanmış bölge: 284-315 gün. Kısaltmak testere işlemleri artırır.")
bandYuzde = input.float(3.0, "Histerezis bandı (%)", minval = 0.0, maxval = 10.0, step = 0.25, group = grpRejim,
     tooltip = "Çıkış için fiyatın SMA'nın bu kadar ALTINA inmesi gerekir (Zakamulin).")

grpZirve = "1b) Zirve İz Stop — tepeye yakın satış"
zirveEsik = input.float(10.0, "Zirveden düşüş eşiği (%)", minval = 3.0, maxval = 30.0, step = 0.5, group = grpZirve,
     tooltip = "Doğrulanmış değer: %10 (SMA 100 gün ile). Satış her zaman son zirvenin en fazla bu kadar altında olur.")
zirveSmaGun = input.int(100, "Geri giriş SMA (gün)", minval = 20, group = grpZirve)
zirveBe = input.bool(true, "Breakeven geri giriş", group = grpZirve,
     tooltip = "Fiyat çıkış fiyatını aşarsa geri gir — yanlış alarmın maliyeti 2 komisyonla sınırlanır (Kaminski & Lo 2014).")

grpST  = "2) Komposit: Supertrend"
stN    = input.int(10,  "ATR periyodu",  minval = 2,  group = grpST)
stMult = input.float(3.0, "ATR çarpanı", minval = 0.5, step = 0.25, group = grpST)

grpEMA   = "3) Komposit: EMA Trendi"
emaHizli = input.int(20,  "Hızlı EMA", minval = 2, group = grpEMA)
emaYavas = input.int(100, "Yavaş EMA", minval = 5, group = grpEMA)

grpMom    = "4) Komposit: Momentum"
macdHizli = input.int(12, "MACD hızlı", minval = 2, group = grpMom)
macdYavas = input.int(26, "MACD yavaş", minval = 5, group = grpMom)
macdSig   = input.int(9,  "MACD sinyal", minval = 2, group = grpMom)
rsiN      = input.int(14, "RSI periyodu", minval = 2, group = grpMom)
rsiEsik   = input.float(50, "RSI eşiği (üzeri boğa oyu)", minval = 30, maxval = 70, group = grpMom)

grpKanal = "5) Komposit: Kanal / Yön"
dcN  = input.int(20, "Donchian periyodu", minval = 5, group = grpKanal)
dmiN = input.int(14, "DMI periyodu", minval = 2, group = grpKanal)

grpPuan   = "6) Komposit: Puanlama"
girisEsik = input.int(5, "Giriş eşiği (kaç oy ile AL)", minval = 1, maxval = 6, group = grpPuan)
cikisEsik = input.int(2, "Çıkış eşiği (bu oy ve altında SAT)", minval = 0, maxval = 5, group = grpPuan)

grpStop   = "7) Komposit: İz Süren Stop (Chandelier)"
chandAcik = input.bool(true, "Chandelier Exit aktif", group = grpStop)
chandN    = input.int(22,  "ATR periyodu", minval = 5, group = grpStop)
chandMult = input.float(3.0, "ATR çarpanı", minval = 1.0, step = 0.25, group = grpStop)

grpElder  = "8) Komposit: Üçlü Ekran (Elder)"
elderAcik = input.bool(false, "Haftalık EMA trend teyidi", group = grpElder)
elderN    = input.int(30, "Haftalık EMA periyodu", minval = 5, group = grpElder)

grpTarih = "9) Backtest Aralığı"
tarihBas = input.time(timestamp("2016-01-01T00:00"), "Başlangıç", group = grpTarih)
tarihBit = input.time(timestamp("2099-01-01T00:00"), "Bitiş", group = grpTarih)

grpGorsel  = "10) Görünüm"
tabloAcik  = input.bool(true, "Performans tablosu", group = grpGorsel)
tabloKonum = input.string("Sağ üst", "Tablo konumu", options = ["Sağ üst", "Sağ alt", "Sol üst", "Sol alt"], group = grpGorsel)
cizgiler   = input.bool(true, "Gösterge çizgileri", group = grpGorsel)

rejimModu  = mod == "Rejim Filtresi (doğrulanmış)"
zirveModu  = mod == "Zirve İz Stop (tepeye yakın satış)"
araliktaMi = time >= tarihBas and time <= tarihBit

// ─── Periyot ölçekleme: "işlem günü" → bar sayısı ───────────────────────────
// Günlük grafik: 1 gün = 1 bar. Haftalık: 252 işlem günü ≈ 52 bar.
olcek = timeframe.isweekly ? 52.0 / 252.0 : timeframe.ismonthly ? 12.0 / 252.0 : 1.0
gun2bar(float gun) => math.max(2, int(math.round(gun * olcek)))

// ─── Rejim Filtresi hesapları ───────────────────────────────────────────────
smaBars  = gun2bar(smaGun)
momBars  = gun2bar(momGun)
rejimSma = ta.sma(close, smaBars)
rejimMom = ta.roc(close, momBars)
rejimHazir  = not na(rejimSma) and not na(rejimMom)
ayiTeyit    = rejimHazir and close < rejimSma * (1 - bandYuzde / 100) and rejimMom < 0
rejimGeri   = rejimHazir and (close > rejimSma or rejimMom > 0)

// ─── Zirve İz Stop durum makinesi ───────────────────────────────────────────
// Sinyal, pozisyondan bağımsız izlenir; satış her zaman zirvenin esik% altında.
zirveSmaBars = gun2bar(zirveSmaGun)
zirveSma     = ta.sma(close, zirveSmaBars)
zirveHazir   = not na(zirveSma) and not na(rejimMom)
var int zirveDurum = 1
var float zirveTepe = na
var float zirveCikisPx = na
zirveTepe := na(zirveTepe) ? close : zirveTepe
if not zirveHazir
    zirveDurum := 1
    zirveTepe := math.max(zirveTepe, close)
else
    if zirveDurum == 1
        zirveTepe := math.max(zirveTepe, close)
        if close < zirveTepe * (1 - zirveEsik / 100)
            zirveDurum := 0
            zirveCikisPx := close
    else
        geriOk = close > zirveSma or rejimMom > 0 or (zirveBe and not na(zirveCikisPx) and close > zirveCikisPx)
        if geriOk
            zirveDurum := 1
            zirveTepe := close

// ─── Komposit hesapları ─────────────────────────────────────────────────────
[stCizgi, stYon] = ta.supertrend(stMult, stN)          // yon < 0 → yükseliş
eH = ta.ema(close, emaHizli)
eY = ta.ema(close, emaYavas)
[macdL, macdS, macdHist] = ta.macd(close, macdHizli, macdYavas, macdSig)
rsiDeger = ta.rsi(close, rsiN)
dcUst  = ta.highest(high, dcN)
dcAlt  = ta.lowest(low, dcN)
dcOrta = (dcUst + dcAlt) / 2
[diArti, diEksi, _adx] = ta.dmi(dmiN, dmiN)

// Onaylanmış (kapanmış) haftalık bar değeri — repaint yapmaz (PineCoders idiyomu)
haftalikEma = request.security(syminfo.tickerid, "W", ta.ema(close, elderN)[1], lookahead = barmerge.lookahead_on)
elderOnay = not elderAcik or timeframe.isweekly or timeframe.ismonthly or close > haftalikEma

oy1 = stYon < 0 ? 1 : 0
oy2 = eH > eY ? 1 : 0
oy3 = macdHist > 0 ? 1 : 0
oy4 = rsiDeger > rsiEsik ? 1 : 0
oy5 = close > dcOrta ? 1 : 0
oy6 = diArti > diEksi ? 1 : 0
puan = oy1 + oy2 + oy3 + oy4 + oy5 + oy6

// Komposit sinyal durum makinesi (histerezis): giriş eşiği aşılınca 1'e geçer,
// çıkış eşiğine düşene KADAR 1 kalır. Pozisyondan bağımsız izlenir ki iz süren
// stop sonrası yeniden giriş, Python motoruyla aynı kurala uysun.
var int kompositDurum = 0
kompositDurum := kompositDurum == 0 ? (puan >= girisEsik ? 1 : 0) : (puan <= cikisEsik ? 0 : 1)

// Chandelier Exit (pozisyona bağlı, sadece yukarı güncellenen stop)
atrChand = ta.atr(chandN)
var float izStop = na
var float pozTepe = na
if strategy.position_size > 0
    pozTepe := na(pozTepe) ? high : math.max(pozTepe, high)
    yeniStop = pozTepe - chandMult * atrChand
    izStop := na(izStop) ? yeniStop : math.max(izStop, yeniStop)
else
    izStop := na
    pozTepe := na

// ─── Emirler ────────────────────────────────────────────────────────────────
// Rejim modu: ısınma döneminde (indikatörler hazır değilken) piyasada kal —
// HODL ile aynı noktadan başla; sadece çifte ayı teyidinde çık.
girisKosul = araliktaMi and strategy.position_size == 0 and
     (rejimModu ? (not rejimHazir or rejimGeri) : zirveModu ? zirveDurum == 1 : (kompositDurum == 1 and elderOnay))
cikisKosul = strategy.position_size > 0 and
     ((rejimModu ? ayiTeyit : zirveModu ? zirveDurum == 0 : kompositDurum == 0) or not araliktaMi)

if girisKosul
    strategy.entry("AL", strategy.long)
    alert(syminfo.ticker + " AL sinyali — BIST HODL-Beater", alert.freq_once_per_bar_close)
if cikisKosul
    strategy.close("AL", comment = "SAT")
    alert(syminfo.ticker + " SAT sinyali — BIST HODL-Beater", alert.freq_once_per_bar_close)
if not rejimModu and not zirveModu and chandAcik and strategy.position_size > 0 and not na(izStop)
    strategy.exit("Stop", from_entry = "AL", stop = izStop, comment = "STOP")

// ─── HODL kıyaslaması ve istatistikler ──────────────────────────────────────
// Aralık bitince HODL/CAGR metrikleri donar — kıyas adil kalır
var float hodlBas = na
var float hodlSon = na
if araliktaMi
    if na(hodlBas)
        hodlBas := close
    hodlSon := close
hodlYuzde = na(hodlBas) or na(hodlSon) ? 0.0 : (hodlSon / hodlBas - 1) * 100
netYuzde  = (strategy.equity / strategy.initial_capital - 1) * 100

var float eqTepe = na
var float maksDus = 0.0
eqTepe := na(eqTepe) ? strategy.equity : math.max(eqTepe, strategy.equity)
maksDus := math.max(maksDus, (eqTepe - strategy.equity) / eqTepe * 100)
var float hodlTepe = na
var float hodlMaksDus = 0.0
if araliktaMi and not na(hodlBas)
    hodlTepe := na(hodlTepe) ? close : math.max(hodlTepe, close)
    hodlMaksDus := math.max(hodlMaksDus, (hodlTepe - close) / hodlTepe * 100)

var int zamanBas = na
var int zamanSon = na
if araliktaMi
    if na(zamanBas)
        zamanBas := time
    zamanSon := time
yilSayisi = na(zamanBas) or na(zamanSon) ? 0.0 : (zamanSon - zamanBas) / (365.25 * 86400000.0)
cagr     = yilSayisi > 0.2 and strategy.equity > 0 ? (math.pow(strategy.equity / strategy.initial_capital, 1 / yilSayisi) - 1) * 100 : na
hodlCagr = yilSayisi > 0.2 and not na(hodlBas) and not na(hodlSon) ? (math.pow(hodlSon / hodlBas, 1 / yilSayisi) - 1) * 100 : na

islemSay   = strategy.closedtrades
kazanmaOr  = islemSay > 0 ? strategy.wintrades * 100.0 / islemSay : 0.0
karFaktoru = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na

// ─── Görsel katman ──────────────────────────────────────────────────────────
plot(cizgiler and rejimModu ? rejimSma : na, "Rejim SMA", color = color.new(color.blue, 0), linewidth = 2)
plot(cizgiler and rejimModu ? rejimSma * (1 - bandYuzde / 100) : na, "Çıkış bandı", color = color.new(color.red, 50))
plot(cizgiler and zirveModu ? zirveSma : na, "Geri Giriş SMA", color = color.new(color.blue, 40))
plot(cizgiler and zirveModu and zirveDurum == 1 ? zirveTepe * (1 - zirveEsik / 100) : na, "Zirve Stop", color = color.new(color.orange, 0), style = plot.style_linebr, linewidth = 2)
plot(cizgiler and not rejimModu and not zirveModu ? stCizgi : na, "Supertrend", color = stYon < 0 ? color.new(color.teal, 0) : color.new(color.red, 0), style = plot.style_linebr)
plot(cizgiler and not rejimModu and not zirveModu and strategy.position_size > 0 ? izStop : na, "İz Süren Stop", color = color.new(color.orange, 0), style = plot.style_circles)

plotshape(girisKosul, "AL", shape.labelup,   location.belowbar, color.new(color.green, 0), text = "AL",  textcolor = color.white, size = size.small)
plotshape(cikisKosul, "SAT", shape.labeldown, location.abovebar, color.new(color.red, 0),   text = "SAT", textcolor = color.white, size = size.small)

// ─── Performans tablosu ─────────────────────────────────────────────────────
konum = tabloKonum == "Sağ üst" ? position.top_right : tabloKonum == "Sağ alt" ? position.bottom_right : tabloKonum == "Sol üst" ? position.top_left : position.bottom_left
var table t = table.new(konum, 2, 13, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 60))

fmt(float x) => na(x) ? "—" : str.tostring(x, "#,##0.0")

if tabloAcik and barstate.islast
    basari = netYuzde > hodlYuzde
    tfUygun = timeframe.isdaily or timeframe.isweekly
    table.cell(t, 0, 0, "BIST HODL-Beater", text_color = color.white, text_size = size.small, bgcolor = color.new(color.blue, 30))
    table.cell(t, 1, 0, (rejimModu ? "Rejim" : zirveModu ? "Zirve Stop" : "Komposit") + " · " + (timeframe.isweekly ? "Haftalık" : timeframe.isdaily ? "Günlük" : timeframe.period), text_color = color.white, text_size = size.small, bgcolor = color.new(color.blue, 30))
    table.cell(t, 0, 1, "Net Kâr", text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 1, fmt(netYuzde) + " %", text_color = netYuzde >= 0 ? color.lime : color.red, text_size = size.small)
    table.cell(t, 0, 2, "HODL (Al-Tut)", text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 2, fmt(hodlYuzde) + " %", text_color = hodlYuzde >= 0 ? color.lime : color.red, text_size = size.small)
    table.cell(t, 0, 3, "Fark (Alpha)", text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 3, (basari ? "+" : "") + fmt(netYuzde - hodlYuzde) + " puan", text_color = basari ? color.lime : color.orange, text_size = size.small)
    table.cell(t, 0, 4, "Yıllık Getiri (CAGR)", text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 4, fmt(cagr) + " % (HODL " + fmt(hodlCagr) + " %)", text_color = color.white, text_size = size.small)
    table.cell(t, 0, 5, "Maks. Düşüş", text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 5, fmt(maksDus) + " % (HODL " + fmt(hodlMaksDus) + " %)", text_color = maksDus <= hodlMaksDus ? color.lime : color.orange, text_size = size.small)
    table.cell(t, 0, 6, "İşlem Sayısı", text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 6, str.tostring(islemSay), text_color = color.white, text_size = size.small)
    table.cell(t, 0, 7, "Kazanma Oranı", text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 7, fmt(kazanmaOr) + " %", text_color = kazanmaOr >= 50 ? color.lime : color.orange, text_size = size.small)
    table.cell(t, 0, 8, "Kâr Faktörü", text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 8, fmt(karFaktoru), text_color = not na(karFaktoru) and karFaktoru >= 1.5 ? color.lime : color.orange, text_size = size.small)
    table.cell(t, 0, 9, "Durum", text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 9, rejimModu ? (ayiTeyit ? "AYI TEYİDİ" : strategy.position_size > 0 ? "LONG" : "NAKİT") : zirveModu ? (zirveDurum == 1 ? "Zirveden " + fmt((zirveTepe - close) / zirveTepe * 100) + " % uzakta" : "NAKİT — geri giriş bekliyor") : ("Puan " + str.tostring(puan) + "/6"), text_color = strategy.position_size > 0 ? color.lime : color.orange, text_size = size.small)
    table.cell(t, 0, 10, "Pozisyon", text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 10, strategy.position_size > 0 ? "LONG" : "NAKİT", text_color = strategy.position_size > 0 ? color.lime : color.gray, text_size = size.small)
    table.cell(t, 0, 11, "HODL'a karşı", text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 11, basari ? "✔ GEÇTİ" : "✘ geride", text_color = basari ? color.lime : color.red, text_size = size.small, bgcolor = basari ? color.new(color.green, 70) : color.new(color.maroon, 60))
    table.cell(t, 0, 12, "Not", text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 12, tfUygun ? (rejimModu or zirveModu ? "Endeks için doğrulandı" : "Deneysel mod") : "⚠ Günlük/Haftalık önerilir", text_color = tfUygun ? color.gray : color.yellow, text_size = size.small)
