//@version=6
// ============================================================================
// BIST Makro Bağlantı Paneli — Intermarket Analizi (John Murphy geleneği)
// ----------------------------------------------------------------------------
// "Savaş çıktı → petrol arttı → havayolu maliyeti arttı" tarzı bağlantıları
// VERİYLE ölçer: grafiği açık hissenin her makro sürücüye karşı SON 6 AYLIK
// getiri korelasyonunu hesaplar ve bunu sürücünün mevcut trendiyle çarpar:
//     katkı = duyarlılık(korelasyon) × sürücü trendi (kendi oynaklığına göre)
// İKİ AYRI SKOR üretir:
//   • DIŞ MAKRO RÜZGAR: petrol + dolar/TL + altın + VIX (asıl makro bağlantı)
//   • PİYASA/SEKTÖR RÜZGARI: XU100 + sektör endeksleri (beta etkisi — hissenin
//     piyasayla birlikte hareketi; ayrı gösterilir ki makro skoru boğmasın)
//
// Veri disiplini: tüm sürücü verisi BİR GÜN GECİKMELİ kullanılır (ABD/emtia
// seansları BIST'ten sonra kapandığı için) — böylece skor tarihçesi, o gün
// BIST kapanışında GERÇEKTEN bilinebilecek bilgiyle birebir aynıdır (repaint
// yok). Sürücü tatilse bayat getiri sayılmaz.
//
// DÜRÜST UYARI: Panel olayları (savaş, faiz kararı) ÖNGÖRMEZ; şu an esen
// rüzgarı ölçer. Literatür bağlantılı varlıklar arasında bilginin yavaş
// yayıldığını destekler (Cohen-Frazzini 2008; Hong-Torous-Valkanov 2007) ama
// olayın kendisi öngörülemez. Karar destek aracıdır, tek başına sinyal değil.
// SADECE GÜNLÜK grafikte kullan.
// ============================================================================
indicator("BIST Makro Bağlantı Paneli", shorttitle = "MakroRüzgar", overlay = false)

// ─── Parametreler ───────────────────────────────────────────────────────────
grpP = "1) Hesap"
korN  = input.int(126, "Duyarlılık penceresi (bar)", minval = 40, tooltip = "Hisse ile sürücü arasındaki getiri korelasyonu bu pencerede ölçülür (~6 ay).", group = grpP)
momN  = input.int(63, "Sürücü momentum penceresi (bar)", minval = 10, tooltip = "Her sürücünün trendi bu penceredeki hareketin, kendi oynaklığına oranıyla ölçülür (~3 ay).", group = grpP)
esikG = input.float(20.0, "Güçlü rüzgar eşiği", minval = 5, maxval = 60, group = grpP)

grpS = "2) Makro sürücüler (değiştirilebilir)"
d1 = input.symbol("TVC:UKOIL",      "Petrol (Brent)", group = grpS)
d2 = input.symbol("FX_IDC:USDTRY",  "Dolar/TL", group = grpS)
d3 = input.symbol("TVC:GOLD",       "Altın (ons USD)", group = grpS)
d9 = input.symbol("TVC:VIX",        "VIX (küresel korku)", group = grpS)
d4 = input.symbol("BIST:XU100",     "BIST 100", group = grpS)
d5 = input.symbol("BIST:XBANK",     "Bankacılık end.", group = grpS)
d6 = input.symbol("BIST:XUSIN",     "Sınai end.", group = grpS)
d7 = input.symbol("BIST:XULAS",     "Ulaştırma end.", group = grpS)
d8 = input.symbol("BIST:XGIDA",     "Gıda end.", group = grpS)

grpG = "3) Görünüm"
tabloKonum = input.string("Sağ üst", "Tablo konumu", options = ["Sağ üst", "Sağ alt", "Sol üst", "Sol alt"], group = grpG)

// ─── Veri: sürücü başına [dünkü getiri, momentum %, bar zamanı] ─────────────
// close[1] tabanlı: BIST kapanışında kesinleşmiş son TAM sürücü barı kullanılır.
al(simge) =>
    request.security(simge, timeframe.period,
         [close[1] / close[2] - 1.0, (close[1] / close[momN + 1] - 1.0) * 100.0, time[1]],
         lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)

[g1, m1, t1] = al(d1)
[g2, m2, t2] = al(d2)
[g3, m3, t3] = al(d3)
[g9, m9, t9] = al(d9)
[g4, m4, t4] = al(d4)
[g5, m5, t5] = al(d5)
[g6, m6, t6] = al(d6)
[g7, m7, t7] = al(d7)
[g8, m8, t8] = al(d8)

// Sürücüde yeni bar yoksa (tatil → gaps_off aynı barı tekrarlar) getiriyi 0 say
temiz(g, t) => t == t[1] ? 0.0 : g
g1x = temiz(g1, t1)
g2x = temiz(g2, t2)
g3x = temiz(g3, t3)
g9x = temiz(g9, t9)
g4x = temiz(g4, t4)
g5x = temiz(g5, t5)
g6x = temiz(g6, t6)
g7x = temiz(g7, t7)
g8x = temiz(g8, t8)

// Hisse getirisi de aynı hizada: dünkü tam bar (eşzamanlı korelasyon)
hisseGetiri = close[1] / close[2] - 1.0

// Duyarlılık: getiri korelasyonu (korN bar)
k1 = ta.correlation(hisseGetiri, g1x, korN)
k2 = ta.correlation(hisseGetiri, g2x, korN)
k3 = ta.correlation(hisseGetiri, g3x, korN)
k9 = ta.correlation(hisseGetiri, g9x, korN)
k4 = ta.correlation(hisseGetiri, g4x, korN)
k5 = ta.correlation(hisseGetiri, g5x, korN)
k6 = ta.correlation(hisseGetiri, g6x, korN)
k7 = ta.correlation(hisseGetiri, g7x, korN)
k8 = ta.correlation(hisseGetiri, g8x, korN)

// Sürücü trend skoru: momentum, sürücünün KENDİ oynaklığıyla normalize edilir
// (z-skoru; 2 sigma hareket = tam sinyal). VIX gibi oynak sürücüler artık
// skoru domine edemez, USDTRY gibi sakin ama kritik sürücüler sönük kalmaz.
trendSkor(m, g) =>
    sigma = ta.stdev(g * 100.0, momN) * math.sqrt(momN)
    na(sigma) or sigma == 0 or na(m) ? na : math.max(-1.0, math.min(1.0, m / sigma / 2.0))

s1 = trendSkor(m1, g1x)
s2 = trendSkor(m2, g2x)
s3 = trendSkor(m3, g3x)
s9 = trendSkor(m9, g9x)
s4 = trendSkor(m4, g4x)
s5 = trendSkor(m5, g5x)
s6 = trendSkor(m6, g6x)
s7 = trendSkor(m7, g7x)
s8 = trendSkor(m8, g8x)

// Katkı = duyarlılık × trend skoru (×100 okunabilirlik)
katki(k, s) => na(k) or na(s) ? na : k * s * 100.0
c1 = katki(k1, s1)
c2 = katki(k2, s2)
c3 = katki(k3, s3)
c9 = katki(k9, s9)
c4 = katki(k4, s4)
c5 = katki(k5, s5)
c6 = katki(k6, s6)
c7 = katki(k7, s7)
c8 = katki(k8, s8)

ort(arr) =>
    toplam = 0.0
    sayi = 0
    for i = 0 to array.size(arr) - 1
        ci = array.get(arr, i)
        if not na(ci)
            toplam += ci
            sayi += 1
    [sayi > 0 ? toplam / sayi : na, sayi]

[skorDis, aktifDis] = ort(array.from(c1, c2, c3, c9))
[skorPiy, aktifPiy] = ort(array.from(c4, c5, c6, c7, c8))

// ─── Grafik ─────────────────────────────────────────────────────────────────
renkDis = na(skorDis) ? color.gray : skorDis > esikG ? color.lime : skorDis < -esikG ? color.red : color.orange
plot(skorDis, "Dış Makro Rüzgar", color = renkDis, linewidth = 2, style = plot.style_area)
plot(skorPiy, "Piyasa/Sektör Rüzgarı", color = color.new(color.blue, 30), linewidth = 1)
plot(esikG, "Üst eşik", color = color.new(color.green, 70))
plot(-esikG, "Alt eşik", color = color.new(color.red, 70))
hline(0, "Sıfır", color = color.new(color.gray, 60))

// ─── Tablo ──────────────────────────────────────────────────────────────────
konum = tabloKonum == "Sağ üst" ? position.top_right : tabloKonum == "Sağ alt" ? position.bottom_right : tabloKonum == "Sol üst" ? position.top_left : position.bottom_left
var table t = table.new(konum, 4, 15, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 60))

fmt(float x) => na(x) ? "—" : str.tostring(x, "#,##0.0")
ok(float m) => na(m) ? "—" : m > 3 ? "↑ +" + fmt(m) + "%" : m < -3 ? "↓ " + fmt(m) + "%" : "→ " + fmt(m) + "%"

satirYaz(int satir, string ad, float m, float k, float c) =>
    table.cell(t, 0, satir, ad, text_color = color.white, text_size = size.small)
    table.cell(t, 1, satir, ok(m), text_color = na(m) ? color.gray : m > 3 ? color.lime : m < -3 ? color.red : color.gray, text_size = size.small)
    table.cell(t, 2, satir, na(k) ? "—" : fmt(k * 100) + " %", text_color = na(k) ? color.gray : math.abs(k) > 0.3 ? color.aqua : color.gray, text_size = size.small)
    table.cell(t, 3, satir, na(c) ? "—" : (c > 0 ? "+" : "") + fmt(c), text_color = na(c) ? color.gray : c > 5 ? color.lime : c < -5 ? color.red : color.gray, text_size = size.small)

araYaz(int satir, string ad, float skor, int aktif, int toplamN) =>
    r = na(skor) ? color.gray : skor > esikG ? color.lime : skor < -esikG ? color.red : color.orange
    table.cell(t, 0, satir, ad, text_color = color.white, text_size = size.small, bgcolor = color.new(color.blue, 40))
    table.cell(t, 1, satir, fmt(skor), text_color = r, text_size = size.small, bgcolor = color.new(color.blue, 40))
    table.cell(t, 2, satir, na(skor) ? "veri yok" : skor > esikG ? "ARKA RÜZGAR" : skor < -esikG ? "KARŞI RÜZGAR" : "nötr", text_color = r, text_size = size.small, bgcolor = color.new(color.blue, 40))
    table.cell(t, 3, satir, str.tostring(aktif) + "/" + str.tostring(toplamN) + " aktif", text_color = color.gray, text_size = size.small, bgcolor = color.new(color.blue, 40))

if barstate.islast
    table.cell(t, 0, 0, syminfo.ticker + (timeframe.isdaily ? "" : " ⚠ SADECE GÜNLÜK"), text_color = timeframe.isdaily ? color.white : color.yellow, text_size = size.small, bgcolor = color.new(color.blue, 30))
    table.cell(t, 1, 0, "Trend (" + str.tostring(momN) + " bar)", text_color = color.white, text_size = size.small, bgcolor = color.new(color.blue, 30))
    table.cell(t, 2, 0, "Duyarlılık", text_color = color.white, text_size = size.small, bgcolor = color.new(color.blue, 30))
    table.cell(t, 3, 0, "Katkı", text_color = color.white, text_size = size.small, bgcolor = color.new(color.blue, 30))
    satirYaz(1, "Petrol (Brent)", m1, k1, c1)
    satirYaz(2, "Dolar/TL", m2, k2, c2)
    satirYaz(3, "Altın (ons)", m3, k3, c3)
    satirYaz(4, "VIX (korku)", m9, k9, c9)
    araYaz(5, "DIŞ MAKRO RÜZGAR", skorDis, aktifDis, 4)
    satirYaz(6, "BIST 100", m4, k4, c4)
    satirYaz(7, "Bankacılık", m5, k5, c5)
    satirYaz(8, "Sınai", m6, k6, c6)
    satirYaz(9, "Ulaştırma", m7, k7, c7)
    satirYaz(10, "Gıda", m8, k8, c8)
    araYaz(11, "PİYASA/SEKTÖR RÜZGARI", skorPiy, aktifPiy, 5)
    table.cell(t, 0, 12, "Nasıl okunur", text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 12, "Duyarlılık: 6 aylık getiri korelasyonu", text_color = color.gray, text_size = size.small)
    table.cell(t, 2, 12, "Katkı = duyarlılık × trend (oynaklığa göre)", text_color = color.gray, text_size = size.small)
    table.cell(t, 3, 12, "", text_size = size.small)
    table.cell(t, 0, 13, "Veri disiplini", text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 13, "Sürücüler 1 gün gecikmeli (repaint yok)", text_color = color.gray, text_size = size.small)
    table.cell(t, 2, 13, "Piyasa rüzgarı = beta etkisi, ayrı okunur", text_color = color.gray, text_size = size.small)
    table.cell(t, 3, 13, "", text_size = size.small)
    table.cell(t, 0, 14, "Uyarı", text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 14, "Olayları öngörmez; mevcut rüzgarı ölçer", text_color = color.yellow, text_size = size.small)
    table.cell(t, 2, 14, "Tek başına al-sat sinyali değildir", text_color = color.yellow, text_size = size.small)
    table.cell(t, 3, 14, "", text_size = size.small)
