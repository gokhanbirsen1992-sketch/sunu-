//@version=6
strategy("Tilson T3 Band Strategy", overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.1)

// Kurallar:
//   On kosul : orta Tilson bandi uzun Tilson bandinin ustunde
//   Kurulum  : orta Tilson AL'dan SAT durumuna gecince izlemeye basla
//   AL       : fiyat bant esiginde ya da ustunde KAPANIRSA
//   SAT      : fiyat bant esiginin altinda KAPANIRSA
// "Bandinda kapanis" icin esik secilebilir: bant ALT kenari (toleransli)
// veya UST kenari (siki).

// ============================================================
// Tilson T3 moving average function
// ============================================================
_tilson(src, _len) =>
    e1 = ta.ema(src, _len)
    e2 = ta.ema(e1, _len)
    e3 = ta.ema(e2, _len)
    e4 = ta.ema(e3, _len)
    e5 = ta.ema(e4, _len)
    e6 = ta.ema(e5, _len)
    ab  = 0.7
    ab2 = ab * ab
    ab3 = ab2 * ab
    c1 = -ab3
    c2 = 3 * ab2 + 3 * ab3
    c3 = -6 * ab2 - 3 * ab - 3 * ab3
    c4 = 1 + 3 * ab + ab3 + 3 * ab2
    c1 * e6 + c2 * e5 + c3 * e4 + c4 * e3

// ============================================================
// Inputs
// ============================================================
len2Fast = input.int(30,  title="Orta Fast", minval=1, group="Orta Tilson (sinyal bandi)")
len2Slow = input.int(40,  title="Orta Slow", minval=1, group="Orta Tilson (sinyal bandi)")
len3Fast = input.int(480, title="Uzun Fast", minval=1, group="Uzun Tilson (trend filtresi)")
len3Slow = input.int(640, title="Uzun Slow", minval=1, group="Uzun Tilson (trend filtresi)")

esik = input.string("Alt kenar", title="Bant esigi (kapanis karsilastirmasi)",
     options=["Alt kenar", "Ust kenar"], group="Strateji",
     tooltip="Alt kenar: bant ici kapanis AL sayilir (toleransli). Ust kenar: bant ici kapanis SAT sayilir (siki).")

// ============================================================
// Calculation
// ============================================================
ma2Fast = _tilson(close, len2Fast)
ma2Slow = _tilson(close, len2Slow)
ma3Fast = _tilson(close, len3Fast)
ma3Slow = _tilson(close, len3Slow)

band2Lo = math.min(ma2Fast, ma2Slow)
band2Hi = math.max(ma2Fast, ma2Slow)
band3Hi = math.max(ma3Fast, ma3Slow)

precond = band2Lo > band3Hi              // orta bant uzun bandin ustunde
midSat  = ma2Fast < ma2Slow              // orta Tilson SAT durumunda
level   = esik == "Alt kenar" ? band2Lo : band2Hi

// Kurulum: orta Tilson AL'dan SAT'a gecti ve on kosul saglaniyor
var bool armed = false
if ta.crossunder(ma2Fast, ma2Slow) and precond
    armed := true
if (not midSat or not precond) and strategy.position_size == 0
    armed := false

// ============================================================
// Orders (kapanista sinyal, ertesi bar acilisinda islem)
// ============================================================
buySig  = armed and midSat and close >= level and strategy.position_size == 0
sellSig = strategy.position_size > 0 and close < level

if buySig
    strategy.entry("Long", strategy.long)
if sellSig
    strategy.close("Long")

// ============================================================
// Plots
// ============================================================
col2 = ma2Fast > ma2Slow ? color.new(color.lime,   70) :
       ma2Fast < ma2Slow ? color.new(color.purple, 70) : na
col3 = ma3Fast > ma3Slow ? color.new(#0ba800,      60) :
       ma3Fast < ma3Slow ? color.new(color.red,    60) : na

p2Fast = plot(ma2Fast, title="Orta Fast", color=color.new(color.gray, 100))
p2Slow = plot(ma2Slow, title="Orta Slow", color=color.new(color.gray, 100))
fill(p2Fast, p2Slow, color=col2, title="Orta Bant")

p3Fast = plot(ma3Fast, title="Uzun Fast", color=color.new(color.gray, 100))
p3Slow = plot(ma3Slow, title="Uzun Slow", color=color.new(color.gray, 100))
fill(p3Fast, p3Slow, color=col3, title="Uzun Bant")

plot(level, title="Esik", color=color.new(color.orange, 40), linewidth=1)
bgcolor(armed and strategy.position_size == 0 ? color.new(color.yellow, 92) : na, title="Izleme modu")
