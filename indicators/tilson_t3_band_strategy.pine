//@version=6
strategy("Tilson T3 Band Strategy", overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.1)

// Kurallar:
//   On kosul : kisa Tilson bandi (6/8) orta Tilson bandinin (30/40) ustunde
//   Kurulum  : kisa Tilson AL'dan SAT durumuna gecince izlemeye basla
//   AL       : fiyat kisa bant esiginde ya da ustunde KAPANIRSA
//   SAT      : fiyat kisa bant esiginin altinda KAPANIRSA

// ============================================================
// Tilson T3 moving average function
// ============================================================
_tilson(src, _len) =>
    e1 = ta.ema(src, _len)
    e2 = ta.ema(e1, _len)
    e3 = ta.ema(e2, _len)
    e4 = ta.ema(e3, _len)
    e5 = ta.ema(e4, _len)
    e6 = ta.ema(e5, _len)
    ab  = 0.7
    ab2 = ab * ab
    ab3 = ab2 * ab
    c1 = -ab3
    c2 = 3 * ab2 + 3 * ab3
    c3 = -6 * ab2 - 3 * ab - 3 * ab3
    c4 = 1 + 3 * ab + ab3 + 3 * ab2
    c1 * e6 + c2 * e5 + c3 * e4 + c4 * e3

// ============================================================
// Inputs
// ============================================================
len1Fast = input.int(6,  title="Kisa Fast", minval=1, group="Kisa Tilson (sinyal bandi)")
len1Slow = input.int(8,  title="Kisa Slow", minval=1, group="Kisa Tilson (sinyal bandi)")
len2Fast = input.int(30, title="Orta Fast", minval=1, group="Orta Tilson (trend filtresi)")
len2Slow = input.int(40, title="Orta Slow", minval=1, group="Orta Tilson (trend filtresi)")

esik = input.string("Alt kenar", title="Bant esigi (kapanis karsilastirmasi)",
     options=["Alt kenar", "Ust kenar"], group="Strateji",
     tooltip="Alt kenar: bant ici kapanis AL sayilir (toleransli). Ust kenar: bant ici kapanis SAT sayilir (siki).")

// ============================================================
// Calculation
// ============================================================
ma1Fast = _tilson(close, len1Fast)
ma1Slow = _tilson(close, len1Slow)
ma2Fast = _tilson(close, len2Fast)
ma2Slow = _tilson(close, len2Slow)

band1Lo = math.min(ma1Fast, ma1Slow)
band1Hi = math.max(ma1Fast, ma1Slow)
band2Hi = math.max(ma2Fast, ma2Slow)

precond  = band1Lo > band2Hi             // kisa bant orta bandin ustunde
shortSat = ma1Fast < ma1Slow             // kisa Tilson SAT durumunda
level    = esik == "Alt kenar" ? band1Lo : band1Hi

// Kurulum: kisa Tilson AL'dan SAT'a gecti ve on kosul saglaniyor
var bool armed = false
if ta.crossunder(ma1Fast, ma1Slow) and precond
    armed := true
if (not shortSat or not precond) and strategy.position_size == 0
    armed := false

// ============================================================
// Orders (kapanista sinyal, ertesi bar acilisinda islem)
// ============================================================
buySig  = armed and shortSat and close >= level and strategy.position_size == 0
sellSig = strategy.position_size > 0 and close < level

if buySig
    strategy.entry("Long", strategy.long)
if sellSig
    strategy.close("Long")

// ============================================================
// Plots
// ============================================================
col1 = ma1Fast > ma1Slow ? color.new(color.blue,  60) :
       ma1Fast < ma1Slow ? color.new(color.black, 70) : na
col2 = ma2Fast > ma2Slow ? color.new(color.lime,   70) :
       ma2Fast < ma2Slow ? color.new(color.purple, 70) : na

p1Fast = plot(ma1Fast, title="Kisa Fast", color=color.new(color.gray, 100))
p1Slow = plot(ma1Slow, title="Kisa Slow", color=color.new(color.gray, 100))
fill(p1Fast, p1Slow, color=col1, title="Kisa Bant")

p2Fast = plot(ma2Fast, title="Orta Fast", color=color.new(color.gray, 100))
p2Slow = plot(ma2Slow, title="Orta Slow", color=color.new(color.gray, 100))
fill(p2Fast, p2Slow, color=col2, title="Orta Bant")

plot(level, title="Esik", color=color.new(color.orange, 40), linewidth=1)
bgcolor(armed and strategy.position_size == 0 ? color.new(color.yellow, 92) : na, title="Izleme modu")
